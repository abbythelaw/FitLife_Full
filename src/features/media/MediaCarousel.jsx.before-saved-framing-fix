import { ChevronLeft,ChevronRight,Image as ImageIcon } from 'lucide-react'
import { useEffect,useMemo,useState } from 'react'
import { isDisplayablePhotoSource } from './imagePersistence'
export default function MediaCarousel({photos=[],fallbackClass='media-fallback',positionX=50,positionY=50,featuredIndex=0}){const valid=useMemo(()=>photos.filter(photo=>isDisplayablePhotoSource(photo?.signed_url||photo?.url||photo?.data_url||photo?.preview)),[photos]);const[index,setIndex]=useState(Math.min(featuredIndex,Math.max(0,valid.length-1)));useEffect(()=>setIndex(Math.min(featuredIndex,Math.max(0,valid.length-1))),[featuredIndex,valid.length]);const photo=valid[Math.min(index,Math.max(0,valid.length-1))];const source=photo&&(photo.signed_url||photo.url||photo.data_url||photo.preview);if(!source)return <div className={`media-carousel ${fallbackClass}`}><ImageIcon size={34}/></div>;const x=photo.position_x??positionX??50,y=photo.position_y??positionY??50;return <div className={`media-carousel ${fallbackClass}`}><img src={source} style={{objectPosition:`${x}% ${y}%`}} onError={e=>{e.currentTarget.style.display='none'}}/>{index===featuredIndex&&<span className="media-featured-badge">★ Featured</span>}{valid.length>1&&<><button className="media-prev" onClick={e=>{e.stopPropagation();setIndex((index-1+valid.length)%valid.length)}}><ChevronLeft/></button><button className="media-next" onClick={e=>{e.stopPropagation();setIndex((index+1)%valid.length)}}><ChevronRight/></button><span className="media-count">{index+1}/{valid.length}</span><div className="media-dots">{valid.map((_,i)=><i className={i===index?'active':''} key={i}/>)}</div></>}</div>}
