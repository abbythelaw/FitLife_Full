/* Fasting Patch 7 nutrition and readings calendar */
.fast-metabolic-inputs{
  grid-column:1/-1;
  display:grid;
  gap:16px;
  padding:22px;
  border:1px solid var(--line);
  border-radius:24px;
  background:var(--card);
}

.metabolic-section-heading{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:18px;
}

.metabolic-section-heading small{
  color:var(--primary);
  font-weight:900;
  letter-spacing:.08em;
}

.metabolic-section-heading h2{
  margin:5px 0;
}

.metabolic-section-heading p{
  max-width:720px;
  margin:0;
  color:var(--muted);
  line-height:1.55;
}

.metabolic-section-heading>button{
  display:flex;
  align-items:center;
  gap:7px;
  min-height:44px;
  padding:10px 14px;
  border:0;
  border-radius:12px;
  background:var(--primary);
  color:#07110a;
  font-weight:900;
}

.metabolic-tabs{
  display:flex;
  gap:8px;
  overflow-x:auto;
  padding-bottom:3px;
}

.metabolic-tabs button{
  display:flex;
  align-items:center;
  gap:7px;
  min-height:42px;
  padding:9px 13px;
  border:1px solid var(--line);
  border-radius:999px;
  background:var(--card2);
  color:var(--muted);
  white-space:nowrap;
}

.metabolic-tabs button.active{
  border-color:color-mix(in srgb,var(--primary) 65%,var(--line));
  background:color-mix(in srgb,var(--primary) 14%,var(--card2));
  color:var(--text);
  box-shadow:0 0 16px color-mix(in srgb,var(--primary) 12%,transparent);
}

.metabolic-tabs svg{
  width:17px;
  height:17px;
}

.metabolic-calendar-layout{
  display:grid;
  grid-template-columns:minmax(520px,1.2fr) minmax(300px,.8fr);
  gap:16px;
  align-items:start;
}

.metabolic-calendar-card,
.metabolic-selected-day{
  min-width:0;
  border:1px solid var(--line);
  border-radius:20px;
  background:var(--card2);
}

.metabolic-calendar-card{
  padding:16px;
}

.metabolic-calendar-card>header{
  display:grid;
  grid-template-columns:44px 1fr 44px;
  gap:8px;
  align-items:center;
}

.metabolic-calendar-card>header h3{
  margin:0;
  text-align:center;
}

.metabolic-calendar-card>header button{
  display:grid;
  place-items:center;
  width:44px;
  height:44px;
  border:1px solid var(--line);
  border-radius:10px;
  background:var(--card);
  color:var(--text);
}

.metabolic-weekdays,
.metabolic-month-grid{
  display:grid;
  grid-template-columns:repeat(7,minmax(0,1fr));
  gap:6px;
}

.metabolic-weekdays{
  margin:16px 0 7px;
}

.metabolic-weekdays span{
  text-align:center;
  color:var(--muted);
  font-size:9px;
  font-weight:800;
}

.metabolic-month-grid>button{
  position:relative;
  display:grid;
  align-content:start;
  gap:5px;
  min-width:0;
  min-height:74px;
  padding:8px;
  overflow:hidden;
  border:1px solid color-mix(in srgb,var(--line) 82%,transparent);
  border-radius:12px;
  background:#0a1922;
  color:var(--muted);
  text-align:left;
}

.metabolic-month-grid>button:hover,
.metabolic-month-grid>button.selected{
  border-color:var(--primary);
  color:var(--text);
}

.metabolic-month-grid>button.selected{
  box-shadow:0 0 0 2px color-mix(in srgb,var(--primary) 18%,transparent);
}

.metabolic-month-grid>button.outside{
  opacity:.3;
}

.metabolic-month-grid>button.future{
  opacity:.2;
  cursor:not-allowed;
}

.metabolic-month-grid>button.has-data{
  background:linear-gradient(
    145deg,
    color-mix(in srgb,var(--primary) 6%,#0a1922),
    #0a1922
  );
}

.metabolic-month-grid>button b{
  font-size:12px;
}

.metabolic-month-grid>button small{
  overflow:hidden;
  color:var(--muted);
  font-size:8px;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.reading-dot{
  width:10px;
  height:10px;
  margin-top:6px;
  border-radius:50%;
  background:var(--reading-colour);
  box-shadow:0 0 10px color-mix(in srgb,var(--reading-colour) 55%,transparent);
}

.metabolic-selected-day{
  padding:18px;
}

.metabolic-selected-day>header{
  margin-bottom:14px;
}

.metabolic-selected-day>header small{
  color:var(--primary);
  font-weight:900;
  letter-spacing:.08em;
}

.metabolic-selected-day>header h3{
  margin:5px 0 0;
}

.metabolic-empty-summary{
  display:grid;
  place-items:center;
  gap:8px;
  width:100%;
  min-height:250px;
  padding:24px;
  border:1px dashed var(--line);
  border-radius:17px;
  background:transparent;
  color:var(--muted);
  text-align:center;
}

.metabolic-empty-summary svg{
  width:32px;
  height:32px;
  color:var(--primary);
}

.metabolic-empty-summary b{
  color:var(--text);
}

.nutrition-day-summary{
  display:grid;
  gap:16px;
}

.nutrition-day-summary>header{
  display:flex;
  justify-content:space-between;
  gap:12px;
  align-items:flex-start;
}

.nutrition-day-summary>header small{
  color:var(--primary);
  font-weight:900;
}

.nutrition-day-summary>header h3{
  margin:4px 0 0;
  font-size:29px;
}

.nutrition-day-summary>header button,
.reading-day-summary>button{
  display:flex;
  align-items:center;
  gap:6px;
  min-height:40px;
  padding:8px 11px;
  border:1px solid var(--line);
  border-radius:10px;
  background:var(--card);
  color:var(--text);
}

.nutrition-macro-values{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:8px;
}

.nutrition-macro-values span,
.nutrition-secondary-values span{
  display:grid;
  gap:3px;
  padding:11px;
  border-radius:12px;
  background:var(--card);
  color:var(--muted);
  font-size:10px;
}

.nutrition-macro-values b,
.nutrition-secondary-values b{
  color:var(--text);
  font-size:17px;
}

.nutrition-macro-values .carbs{
  box-shadow:inset 0 0 0 1px rgba(56,189,248,.28);
}

.nutrition-macro-values .fat{
  box-shadow:inset 0 0 0 1px rgba(251,191,36,.28);
}

.nutrition-macro-values .protein{
  box-shadow:inset 0 0 0 1px rgba(167,139,250,.28);
}

.nutrition-macro-visual{
  display:grid;
  gap:9px;
}

.nutrition-macro-bar{
  display:flex;
  width:100%;
  height:18px;
  overflow:hidden;
  border-radius:999px;
  background:#263038;
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.06);
}

.nutrition-macro-bar i{
  display:block;
  height:100%;
  min-width:0;
}

.nutrition-macro-bar .macro-carbs{
  background:linear-gradient(90deg,#0ea5e9,#38bdf8);
}

.nutrition-macro-bar .macro-fat{
  background:linear-gradient(90deg,#f59e0b,#fbbf24);
}

.nutrition-macro-bar .macro-protein{
  background:linear-gradient(90deg,#8b5cf6,#a78bfa);
}

.nutrition-macro-visual.compact{
  gap:0;
}

.nutrition-macro-visual.compact .nutrition-macro-bar{
  height:7px;
}

.nutrition-macro-legend{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:7px;
}

.nutrition-macro-legend span{
  display:grid;
  grid-template-columns:auto 1fr auto;
  align-items:center;
  gap:5px;
  color:var(--muted);
  font-size:9px;
}

.nutrition-macro-legend span>i{
  width:8px;
  height:8px;
  border-radius:50%;
}

.nutrition-macro-legend .carbs>i{
  background:#38bdf8;
}

.nutrition-macro-legend .fat>i{
  background:#fbbf24;
}

.nutrition-macro-legend .protein>i{
  background:#a78bfa;
}

.nutrition-macro-legend b{
  color:var(--text);
}

.nutrition-secondary-values{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:8px;
}

.nutrition-day-summary footer{
  color:var(--muted);
  font-size:10px;
}

.reading-day-summary{
  display:grid;
  grid-template-columns:48px 1fr auto;
  gap:12px;
  align-items:center;
  min-height:170px;
}

.reading-day-summary>span{
  display:grid;
  place-items:center;
  width:48px;
  height:48px;
  border-radius:14px;
  background:color-mix(in srgb,var(--reading-colour) 14%,var(--card));
  color:var(--reading-colour);
  box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--reading-colour) 30%,transparent);
}

.reading-day-summary small{
  color:var(--muted);
  font-weight:900;
}

.reading-day-summary h3{
  margin:5px 0;
  font-size:28px;
}

.reading-day-summary p{
  margin:0;
  color:var(--muted);
  line-height:1.5;
}

.nutrition-editor{
  width:min(680px,100%)!important;
}

.nutrition-editor-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:0 12px;
}

.nutrition-editor textarea{
  min-height:90px;
  resize:vertical;
}

.nutrition-delete-confirm{
  display:grid;
  gap:8px;
  margin-top:15px;
  padding:14px;
  border:1px solid rgba(251,113,133,.45);
  border-radius:14px;
  background:rgba(127,29,29,.2);
  color:#fecdd3;
}

.nutrition-delete-confirm p{
  margin:0;
  font-size:12px;
  line-height:1.5;
}

.nutrition-delete-confirm>div{
  display:flex;
  gap:8px;
}

.nutrition-delete-confirm button,
.fast-editor-actions .danger{
  min-height:42px;
  padding:8px 11px;
  border:1px solid var(--line);
  border-radius:10px;
  background:var(--card2);
  color:var(--text);
}

.nutrition-delete-confirm .danger,
.fast-editor-actions .danger{
  border-color:rgba(251,113,133,.45);
  background:rgba(127,29,29,.25);
  color:#fecdd3;
}

@media(max-width:1050px){
  .metabolic-calendar-layout{
    grid-template-columns:1fr;
  }
}

@media(max-width:650px){
  .fast-metabolic-inputs{
    padding:14px;
  }

  .metabolic-section-heading{
    display:grid;
  }

  .metabolic-section-heading>button{
    width:100%;
    justify-content:center;
  }

  .metabolic-calendar-card{
    padding:10px;
  }

  .metabolic-month-grid>button{
    min-height:57px;
    padding:5px;
    border-radius:8px;
  }

  .nutrition-editor-grid{
    grid-template-columns:1fr 1fr;
  }

  .nutrition-macro-values,
  .nutrition-secondary-values,
  .nutrition-macro-legend{
    grid-template-columns:repeat(3,minmax(0,1fr));
  }

  .reading-day-summary{
    grid-template-columns:44px 1fr;
  }

  .reading-day-summary>button{
    grid-column:1/-1;
    justify-content:center;
  }
}

/* Best-ever streak trophy: compact top-right corner badge */
.fast-month-day .fast-streak-badge.trophy {
  top: 4px !important;
  right: 4px !important;

  width: 25px !important;
  height: 25px !important;

  translate: 0 0 !important;

  border: 1px solid rgba(255, 235, 150, .72) !important;
  border-radius: 9px !important;

  background:
    linear-gradient(
      145deg,
      #ffe26a,
      #d99d1d
    ) !important;

  color: #3c2900 !important;

  box-shadow:
    0 2px 7px rgba(0, 0, 0, .32),
    0 0 8px rgba(255, 210, 68, .18) !important;
}

.fast-month-day .fast-streak-badge.trophy svg {
  width: 13px !important;
  height: 13px !important;
}

.fast-month-day .fast-streak-badge.trophy strong {
  position: absolute !important;
  right: -3px !important;
  bottom: -5px !important;

  display: grid !important;
  place-items: center !important;

  min-width: 14px !important;
  height: 14px !important;
  padding: 0 3px !important;

  border: 1px solid rgba(255, 240, 180, .7) !important;
  border-radius: 999px !important;

  background: #b9780c !important;
  color: #fff8dc !important;

  font-size: 8px !important;
  font-weight: 900 !important;
  line-height: 1 !important;
}

/* Historical trophy remains slightly muted */
.fast-month-day .fast-streak-badge.trophy.historical {
  opacity: .88 !important;
}

/* Prevent the corner badge from covering the date number */
.fast-month-day.best-streak.segment-end {
  padding-right: 29px !important;
}

@media (max-width: 650px) {
  .fast-month-day .fast-streak-badge.trophy {
    top: 3px !important;
    right: 3px !important;

    width: 22px !important;
    height: 22px !important;

    border-radius: 8px !important;
  }

  .fast-month-day .fast-streak-badge.trophy svg {
    width: 11px !important;
    height: 11px !important;
  }

  .fast-month-day.best-streak.segment-end {
    padding-right: 24px !important;
  }
}

/* Tiny best-ever trophy marker */
.fast-month-day .fast-streak-badge.trophy {
  top: 3px !important;
  right: 3px !important;

  width: 17px !important;
  height: 17px !important;

  translate: 0 0 !important;

  border: 1px solid rgba(255, 229, 130, .65) !important;
  border-radius: 6px !important;

  background: #e6ad27 !important;
  color: #3c2900 !important;

  box-shadow:
    0 1px 4px rgba(0, 0, 0, .28) !important;
}

.fast-month-day .fast-streak-badge.trophy svg {
  width: 9px !important;
  height: 9px !important;
}

/* Hide the separate numbered bubble */
.fast-month-day .fast-streak-badge.trophy strong {
  display: none !important;
}

/* No extra space needed for the small corner trophy */
.fast-month-day.best-streak.segment-end {
  padding-right: 8px !important;
}

@media (max-width: 650px) {
  .fast-month-day .fast-streak-badge.trophy {
    top: 2px !important;
    right: 2px !important;

    width: 15px !important;
    height: 15px !important;

    border-radius: 5px !important;
  }

  .fast-month-day .fast-streak-badge.trophy svg {
    width: 8px !important;
    height: 8px !important;
  }
}


/* Fasting Patch 8 inactive grey journey ring */
.inactive-fast-hero{
  grid-column:1!important;
  position:relative;
  display:grid!important;
  grid-template-columns:minmax(270px,.9fr) minmax(230px,.7fr)!important;
  gap:22px!important;
  min-width:0;
  padding:20px!important;
  overflow:visible!important;
  border-color:#34414a!important;
  background:
    radial-gradient(
      circle at 30% 42%,
      rgba(148,163,184,.07),
      transparent 44%
    ),
    var(--card)!important;
}

.inactive-fast-target{
  position:absolute;
  z-index:12;
  top:14px;
  right:14px;
  display:flex;
  gap:8px;
  align-items:center;
}

.inactive-fast-target label{
  position:relative;
  display:flex;
  align-items:center;
  gap:7px;
  min-height:40px;
  padding:0 34px 0 12px;
  border:1px solid #45515a;
  border-radius:999px;
  background:#0c171bea;
  color:#9ca3af;
}

.inactive-fast-target label>span{
  font-size:9px;
  font-weight:900;
  letter-spacing:.08em;
  text-transform:uppercase;
}

.inactive-fast-target select,
.inactive-fast-target input{
  min-width:64px;
  padding:9px 0;
  border:0;
  outline:0;
  background:transparent;
  color:#d1d5db;
  font-weight:900;
}

.inactive-fast-target select{
  appearance:none;
}

.inactive-fast-target svg{
  position:absolute;
  right:9px;
  width:15px;
  pointer-events:none;
}

.inactive-custom-hours{
  padding-right:12px!important;
}

.inactive-custom-hours input{
  width:58px;
}

.inactive-fast-ring-column{
  display:grid;
  place-items:center;
  gap:10px;
  padding-top:20px;
}

.inactive-journey-wrap{
  min-height:0!important;
  padding:34px 8px 4px!important;
}

.inactive-journey-ring{
  width:280px!important;
  background:#53606a!important;
  box-shadow:
    0 0 0 1px rgba(209,213,219,.12),
    0 8px 28px rgba(0,0,0,.28)!important;
}

.inactive-journey-ring:before{
  inset:17px!important;
  background:#07130f!important;
}

.inactive-journey-ring:after{
  display:none!important;
}

.inactive-journey-ring .fast-phase-point{
  width:38px!important;
  height:38px!important;
  margin:-19px!important;
  transform:
    rotate(var(--angle))
    translate(140px)
    rotate(calc(-1*var(--angle)))!important;
}

.inactive-journey-ring .fast-phase-point.untouched{
  border:1px solid #e1e4e7!important;
  background:#cfd4d8!important;
  color:#667078!important;
  box-shadow:0 3px 8px rgba(0,0,0,.3)!important;
  animation:none!important;
  filter:none!important;
}

.inactive-journey-ring .fast-phase-point.untouched span{
  color:#667078!important;
  filter:grayscale(1)!important;
  opacity:.48!important;
  font-size:14px!important;
}

.inactive-journey-ring .fast-phase-point.untouched b{
  color:#667078!important;
  font-size:8px!important;
}

.inactive-journey-ring .fast-phase-point.untouched small{
  position:absolute;
  top:43px;
  left:50%;
  width:78px;
  translate:-50% 0;
  overflow:hidden;
  color:#7b858c!important;
  font-size:7px;
  font-weight:800;
  line-height:1.15;
  text-align:center;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.inactive-ring-center{
  cursor:default!important;
}

.inactive-ring-center strong{
  color:#d1d5db!important;
  font-size:36px!important;
}

.inactive-ring-center small,
.inactive-ring-center em,
.inactive-ring-center i{
  color:#7d878e!important;
}

.inactive-ring-center em{
  margin-top:9px;
  font-size:11px;
  font-style:normal;
  font-weight:900;
}

.inactive-start-fast{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  width:min(100%,280px);
  min-height:46px;
  padding:11px 15px;
  border:0;
  border-radius:14px;
  background:var(--primary);
  color:#07110a;
  font-weight:900;
  box-shadow:0 8px 22px color-mix(in srgb,var(--primary) 18%,transparent);
}

.inactive-fast-copy{
  align-self:center;
  padding:40px 4px 0;
}

.inactive-stage{
  color:#9ca3af!important;
}

.inactive-fast-copy h3{
  margin:10px 0;
  color:#d8dde0;
  font-size:25px;
}

.inactive-fast-copy>p{
  color:#8e999f;
  line-height:1.65;
}

.inactive-fast-rules{
  display:grid;
  gap:8px;
  margin-top:18px;
}

.inactive-fast-rules span{
  display:flex;
  align-items:center;
  gap:9px;
  color:#879198;
  font-size:11px;
}

.inactive-fast-rules i{
  width:13px;
  height:13px;
  border-radius:50%;
}

.inactive-fast-rules .rule-grey{
  background:#cfd4d8;
}

.inactive-fast-rules .rule-colour{
  background:linear-gradient(135deg,#38bdf8,#8b5cf6);
}

.inactive-fast-rules .rule-glow{
  background:#70e236;
  box-shadow:0 0 9px rgba(112,226,54,.6);
}

/* Ensure the old large protocol grid never appears in the inactive state. */
.fasting-page>.protocols{
  display:none!important;
}

@media(max-width:1050px){
  .inactive-fast-hero{
    grid-column:1!important;
  }
}

@media(max-width:760px){
  .inactive-fast-hero{
    grid-template-columns:1fr!important;
    gap:5px!important;
  }

  .inactive-fast-target{
    position:relative;
    top:auto;
    right:auto;
    justify-content:flex-end;
    flex-wrap:wrap;
    margin-bottom:-25px;
  }

  .inactive-fast-copy{
    padding:12px 4px 4px;
    text-align:center;
  }

  .inactive-fast-rules{
    width:min(100%,290px);
    margin:16px auto 0;
    text-align:left;
  }
}

@media(max-width:650px){
  .inactive-journey-ring{
    width:240px!important;
  }

  .inactive-journey-ring .fast-phase-point{
    width:34px!important;
    height:34px!important;
    margin:-17px!important;
    transform:
      rotate(var(--angle))
      translate(120px)
      rotate(calc(-1*var(--angle)))!important;
  }

  .inactive-journey-ring .fast-phase-point.untouched small{
    top:39px;
    width:65px;
    font-size:6px;
  }

  .inactive-fast-target label{
    min-height:38px;
  }
}


/* Fasting Patch 9 editable start end and target */
.fast-time-editor{
  width:min(680px,100%)!important;
  overflow-y:auto!important;
  overscroll-behavior:contain;
}

.fast-editor-close{
  display:grid!important;
  place-items:center!important;
  width:44px!important;
  height:44px!important;
  padding:0!important;
  border-radius:50%!important;
}

.fast-editor-close svg{
  width:21px;
  height:21px;
}

.fast-editor-intro{
  margin:8px 52px 18px 0;
  color:var(--muted);
  line-height:1.6;
}

.fast-time-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}

.fast-editor-preview{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:9px;
  margin-top:18px;
}

.fast-editor-preview span{
  display:grid;
  gap:4px;
  min-width:0;
  padding:12px;
  border:1px solid var(--line);
  border-radius:13px;
  background:var(--card);
}

.fast-editor-preview small{
  color:var(--muted);
  font-size:8px;
  font-weight:900;
  letter-spacing:.08em;
}

.fast-editor-preview b{
  overflow:hidden;
  color:var(--text);
  font-size:12px;
  line-height:1.35;
  text-overflow:ellipsis;
}

.fast-time-editor .fast-validation-error{
  position:relative;
  z-index:1;
}

.fast-time-editor input[type="datetime-local"]{
  color-scheme:dark;
}

.fast-time-editor .fast-editor-actions{
  z-index:20;
}

@media(max-width:650px){
  .fast-time-grid,
  .fast-editor-preview{
    grid-template-columns:1fr;
  }

  .fast-editor-intro{
    margin-right:44px;
  }
}
