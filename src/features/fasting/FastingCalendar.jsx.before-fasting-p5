
import {useMemo,useState} from 'react'
const key=d=>[d.getFullYear(),String(d.getMonth()+1).padStart(2,'0'),String(d.getDate()).padStart(2,'0')].join('-')
const hours=row=>Math.max(0,(new Date(row.ended_at||row.expected_end_at)-new Date(row.started_at))/36e5)
export default function FastingCalendar({sessions=[]}){const[range,setRange]=useState(30),[selected,setSelected]=useState(null);const completed=sessions.filter(x=>x.status==='completed'&&x.ended_at);const days=useMemo(()=>{const today=new Date();return Array.from({length:range},(_,i)=>{const d=new Date(today);d.setDate(today.getDate()-(range-1-i));const matches=completed.filter(x=>String(x.started_at).slice(0,10)===key(d));const best=[...matches].sort((a,b)=>hours(b)-hours(a))[0],actual=best?hours(best):0,target=Number(best?.target_hours||0);return{date:key(d),d,best,actual,state:!best?'empty':actual<target?'partial':actual>target?'exceeded':'complete'}})},[sessions,range]);let current=0;for(const d of [...days].reverse()){if(d.best)current++;else break}let best=0,n=0;for(const d of days){n=d.best?n+1:0;best=Math.max(best,n)}return <section className="fast-calendar-card"><header><div><small>FASTING CALENDAR</small><h2>Consistency</h2></div><div>{[30,90,365].map(v=><button className={range===v?'active':''} onClick={()=>setRange(v)} key={v}>{v===365?'1Y':`${v}D`}</button>)}</div></header><div className="fast-calendar-stats"><span><b>{current}</b>Current streak</span><span><b>{best}</b>Best streak</span><span><b>{completed.length}</b>Completed fasts</span></div><div className="fast-calendar-grid">{days.map(day=><button key={day.date} className={day.state} title={`${day.date}: ${day.actual.toFixed(1)}h`} onClick={()=>setSelected(day)}><i/><small>{day.d.getDate()}</small></button>)}</div><div className="fast-calendar-legend"><span><i className="empty"/>No fast</span><span><i className="partial"/>Partial</span><span><i className="complete"/>Target met</span><span><i className="exceeded"/>Exceeded</span></div>{selected&&<div className="fast-day-detail"><button onClick={()=>setSelected(null)}>Close</button><small>{selected.date}</small><h3>{selected.best?`${selected.actual.toFixed(1)} hour fast`:'No completed fast'}</h3>{selected.best&&<p>{selected.best.protocol} · Target {selected.best.target_hours}h · {selected.state==='partial'?'Ended early':selected.state==='exceeded'?'Exceeded target':'Target met'}</p>}</div>}</section>}
