import {useMemo} from 'react'
import {allReadingsForMetric,listNutritionDays,macroContribution} from './fastingNutritionStore'
const dateKey=d=>d.toISOString().slice(0,10)
const recentDates=()=>Array.from({length:30},(_,i)=>{const d=new Date();d.setDate(d.getDate()-(29-i));return dateKey(d)})
function DotPlot({metric}){const rows=allReadingsForMetric(metric).slice(-30),values=rows.map(r=>Number(r.normalized_value)).filter(Number.isFinite);const min=values.length?Math.min(...values):0,max=values.length?Math.max(...values):1,range=Math.max(1,max-min);return <div className="metric-dot-plot"><div className="dot-plot-stage">{rows.map((row,i)=><button key={row.id||i} title={`${row.normalized_date}: ${row.normalized_value}`} style={{left:`${rows.length===1?50:i/(rows.length-1)*100}%`,bottom:`${(Number(row.normalized_value)-min)/range*80+10}%`}}/>)}</div><small>{values.length?`${min.toFixed(1)}–${max.toFixed(1)} · 30D`:'No readings yet'}</small></div>}
function NutritionBars(){const map=new Map(listNutritionDays().map(r=>[r.date,r])),dates=recentDates(),rows=dates.map(date=>map.get(date)).filter(Boolean),max=Math.max(1,...rows.map(r=>Number(r.calories||0)));return <div className="nutrition-30d-bars"><header><b>30D Nutrition</b><span><i className="c"/>Carbs <i className="f"/>Fat <i className="p"/>Protein</span></header><div className="nutrition-target-lines"><i/><i/><i/><i/></div>{rows.slice(-14).map(row=>{const m=macroContribution(row),width=Number(row.calories||0)/max*100;return <button key={row.date} title={`${row.date}: ${row.calories} kcal`}><small>{row.date.slice(5)}</small><span style={{width:`${width}%`,opacity:row.completeness==='Partial day'?.5:1}}><i className="c" style={{width:`${m.carbs}%`}}/><i className="f" style={{width:`${m.fat}%`}}/><i className="p" style={{width:`${m.protein}%`}}/></span><b>{row.calories} kcal</b></button>})}</div>}
export default function FastingThirtyDayGraph({tab}){return <section className="fasting-30d-graph">{tab==='nutrition'?<NutritionBars/>:<DotPlot metric={tab}/>}</section>}

