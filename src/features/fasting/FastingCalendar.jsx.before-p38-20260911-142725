import {useMemo,useState} from 'react'
import {Activity,ChevronLeft,ChevronRight,Flame,Trophy,X} from 'lucide-react'
import {listNutritionDays,macroContribution,normalizedHealthReadings,readingsForMetric} from './fastingNutritionStore'

const key=d=>[d.getFullYear(),String(d.getMonth()+1).padStart(2,'0'),String(d.getDate()).padStart(2,'0')].join('-')
const dayStart=d=>new Date(d.getFullYear(),d.getMonth(),d.getDate())
const dayEnd=d=>new Date(d.getFullYear(),d.getMonth(),d.getDate()+1)
const endOf=(row,now)=>row.status==='active'?new Date(now):new Date(row.ended_at||row.expected_end_at||row.started_at)
const hours=(row,now)=>Math.max(0,(endOf(row,now)-new Date(row.started_at))/36e5)
const prettyDuration=value=>{const minutes=Math.max(0,Math.round(Number(value||0)*60));return `${Math.floor(minutes/60)}h ${String(minutes%60).padStart(2,'0')}m`}
function overlap(row,date,now){const start=new Date(row.started_at),end=endOf(row,now);return Math.max(0,(Math.min(end,dayEnd(date))-Math.max(start,dayStart(date)))/36e5)}
function allDays(sessions,now){const valid=sessions.filter(x=>x.started_at&&!x.deleted_at);if(!valid.length)return[];const earliest=new Date(Math.min(...valid.map(x=>new Date(x.started_at))));const result=[];for(let d=dayStart(earliest),today=dayStart(new Date(now));d<=today;d=new Date(d.getFullYear(),d.getMonth(),d.getDate()+1)){const coverage=valid.reduce((sum,row)=>sum+overlap(row,d,now),0);result.push({date:new Date(d),key:key(d),coverage,qualifies:coverage>=12})}return result}
function streakGroups(days){const groups=[];let group=[];for(const day of days){if(day.qualifies)group.push(day);else if(group.length){groups.push(group);group=[]}}if(group.length)groups.push(group);return groups}
function metricName(row){return String(row.normalized_metric||row.metric||row.type||row.name||'').toLowerCase()}
function readingsDuring(fast,metric){const start=new Date(fast.started_at),end=endOf(fast,Date.now());return normalizedHealthReadings().filter(row=>{const at=new Date(`${row.normalized_date}T${row.normalized_time||'12:00'}`);return at>=start&&at<=end&&metricName(row).includes(metric)})}
function FastStats({fast,now,onClose,onEdit}){const duration=hours(fast,now),target=Number(fast.target_hours||0),start=new Date(fast.started_at),end=endOf(fast,now),dates=[];for(let d=dayStart(start);d<=dayStart(end);d=new Date(d.getFullYear(),d.getMonth(),d.getDate()+1))dates.push(new Date(d));const earned=dates.filter(d=>overlap(fast,d,now)>=12).length;const phases=[4,8,12,16,18,24,36,48,72].filter(h=>duration>=h).length;const nutrition=listNutritionDays().filter(row=>row.date>=key(start)&&row.date<=key(end));const complete=nutrition.filter(row=>row.completeness==='Complete day');const avg=name=>nutrition.length?nutrition.reduce((s,r)=>s+Number(r[name]||0),0)/nutrition.length:0;const macro=macroContribution({protein_g:avg('protein_g'),carbs_g:avg('carbs_g'),fat_g:avg('fat_g')});const items=[['glucose','Blood glucose'],['weight','Weight'],['resting heart rate','RHR'],['hba1c','HbA1c']].map(([id,label])=>({id,label,rows:readingsDuring(fast,id)}));return <div className="fast-layer"><button className="fast-backdrop" onClick={onClose}/><section className="recent-fast-modal"><button className="recent-fast-close" onClick={onClose}><X/></button><small>RECENT FAST</small><h2>{fast.protocol||'Custom'} fast</h2><p>{start.toLocaleString()} to {end.toLocaleString()}</p><strong className="recent-fast-duration">{prettyDuration(duration)}</strong><div className="recent-fast-stats"><span><b>{target}h</b>Target</span><span><b>{target?Math.round(duration/target*100):0}%</b>Target result</span><span><b>{Math.max(0,duration-target).toFixed(1)}h</b>Exceeded</span><span><b>{dates.length}</b>Calendar dates</span><span><b>{earned}</b>Streak days</span><span><b>{phases}/9</b>Phases reached</span></div>{items.some(x=>x.rows.length)&&<section><h3>Metabolic context</h3><div className="recent-metric-grid">{items.filter(x=>x.rows.length).map(item=><article key={item.id}><b>{item.label}</b><span>{item.rows[0].normalized_value} {item.rows[0].normalized_unit||''}</span>{item.rows.length>1&&<small>Latest: {item.rows.at(-1).normalized_value} {item.rows.at(-1).normalized_unit||''}</small>}</article>)}</div></section>}{nutrition.length>0&&<section><h3>Daily nutrition summaries overlapping this fast</h3><p>{nutrition.length} recorded day(s), {complete.length} complete.</p><div className="recent-macro-bar"><i style={{width:`${macro.carbs}%`}}/><i style={{width:`${macro.fat}%`}}/><i style={{width:`${macro.protein}%`}}/></div><p>{macro.carbs.toFixed(0)}% carbohydrate · {macro.fat.toFixed(0)}% fat · {macro.protein.toFixed(0)}% protein</p><p>Average {avg('calories').toFixed(0)} kcal · Fiber {avg('fiber_g').toFixed(1)}g · Sugar {avg('sugar_g').toFixed(1)}g</p></section>}<footer><button onClick={()=>onEdit(fast)}>Edit fast</button><button onClick={onClose}>Close</button></footer></section></div>}

function dataDotsForDate(date,sessions,now){
  const dots=[]
  if(sessions.some(row=>row.started_at&&overlap(row,new Date(`${date}T12:00:00`),now)>0))dots.push({id:'fast',label:'Fast'})
  if(listNutritionDays().some(row=>row.date===date))dots.push({id:'nutrition',label:'Nutrition'})
  for(const metric of ['glucose','rhr','weight','hba1c']){
    if(readingsForMetric(metric).some(row=>row.normalized_date===date))dots.push({id:metric,label:metric==='rhr'?'RHR':metric==='hba1c'?'HbA1c':metric[0].toUpperCase()+metric.slice(1)})
  }
  return dots
}

export default function FastingCalendar({sessions=[],now=Date.now(),onEditFast,onChooseDate}){const today=new Date(now),[month,setMonth]=useState(new Date(today.getFullYear(),today.getMonth(),1)),[selectedFast,setSelectedFast]=useState(null);const days=useMemo(()=>allDays(sessions,now),[sessions,now]);const groups=useMemo(()=>streakGroups(days),[days]);const best=Math.max(0,...groups.map(x=>x.length));const current=groups.find(x=>x.at(-1)?.key===key(today))||[];const first=new Date(month.getFullYear(),month.getMonth(),1),start=new Date(first);start.setDate(1-((first.getDay()+6)%7));const cells=Array.from({length:42},(_,i)=>{const d=new Date(start);d.setDate(start.getDate()+i);return days.find(x=>x.key===key(d))||{date:d,key:key(d),coverage:0,qualifies:false}});const recent=[...sessions].filter(x=>x.status==='completed'&&x.ended_at).sort((a,b)=>new Date(b.started_at)-new Date(a.started_at)).slice(0,5);const groupOf=day=>groups.find(group=>group.some(x=>x.key===day.key));return <section className="fast-calendar-card exercises-style-calendar"><header className="fast-calendar-month-head"><button onClick={()=>setMonth(new Date(month.getFullYear(),month.getMonth()-1,1))}><ChevronLeft/></button><h2>{new Intl.DateTimeFormat('en-GB',{month:'long',year:'numeric'}).format(month)}</h2><button onClick={()=>setMonth(new Date(month.getFullYear(),month.getMonth()+1,1))}><ChevronRight/></button></header><div className="fast-calendar-weekdays">{['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].map(x=><span key={x}>{x}</span>)}</div><div className="fast-month-grid">{cells.map((day,index)=>{const isFuture=day.key>key(today),group=groupOf(day),position=group?.findIndex(x=>x.key===day.key)??-1,rowStart=index%7===0,rowEnd=index%7===6,isCurrent=group===current,isBest=group?.length===best&&best>0,end=day.qualifies&&(position===group.length-1||rowEnd),start=day.qualifies&&(position===0||rowStart),badge=end&&position===group.length-1;return <button key={day.key} className={['fast-month-day',day.date.getMonth()!==month.getMonth()?'outside':'',day.qualifies?'qualifies':'break-day',start?'segment-start':'',end?'segment-end':'',isBest?'best-streak':'',day.key===key(today)?'today':'',isFuture?'future':''].filter(Boolean).join(' ')} onClick={()=>{if(!isFuture)onChooseDate?.(day.key)}} disabled={isFuture}><b>{day.date.getDate()}</b><span className="fast-calendar-data-dots">{dataDotsForDate(day.key,sessions,now).slice(0,3).map(dot=><i key={dot.id} className={dot.id} title={dot.label}/>)}{dataDotsForDate(day.key,sessions,now).length>3&&<small>+{dataDotsForDate(day.key,sessions,now).length-3}</small>}</span>{badge&&isCurrent&&<span className={`fast-streak-badge ${isBest?'trophy':'flame'}`}>{isBest?<Trophy/>:<Flame/>}</span>}{badge&&!isCurrent&&isBest&&<span className="fast-streak-badge trophy historical"><Trophy/></span>}</button>})}</div><div className="fast-calendar-dot-legend"><span><i className="fast"/>Fast</span><span><i className="nutrition"/>Nutrition</span><span><i className="glucose"/>Glucose</span><span><i className="rhr"/>RHR</span><span><i className="weight"/>Weight</span><span><i className="hba1c"/>HbA1c</span></div><div className="fast-streak-summary"><span><Flame/><b>{current.length}</b>Current streak</span><span><Trophy/><b>{best}</b>Best-ever streak</span><small>A day qualifies after at least 12 fasting hours within that local calendar date.</small></div><section className="fast-recent-list"><h3>Recent fasts</h3>{recent.length?recent.map(row=><button key={row.id} onClick={()=>setSelectedFast(row)}><span>{new Date(row.started_at).toLocaleDateString('en-GB')}</span><b>{row.protocol||'Custom'}</b><small>{prettyDuration(hours(row,now))}</small><ChevronRight/></button>):<p>No completed fasts yet.</p>}</section>{selectedFast&&<FastStats fast={selectedFast} now={now} onClose={()=>setSelectedFast(null)} onEdit={fast=>{setSelectedFast(null);onEditFast?.(fast)}}/>}</section>}
