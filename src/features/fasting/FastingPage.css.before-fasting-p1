.fasting-page{display:grid;gap:18px;max-width:1120px}.fasting-heading{display:flex;justify-content:space-between;align-items:center}.fasting-heading small{color:var(--primary);font-weight:800}.fasting-heading h2{font-size:30px;margin:5px 0}.fasting-heading p{margin:0;color:var(--muted)}.fasting-heading button,.fast-drawer .save{background:var(--primary);color:#07110a;border:0;border-radius:10px;padding:11px 15px;font-weight:800;display:flex;gap:7px}.protocols{display:grid;grid-template-columns:repeat(5,1fr);gap:9px}.protocols button{min-height:105px;background:var(--card);border:1px solid var(--line);color:var(--text);border-radius:14px;display:grid;place-items:center}.protocols b{font-size:20px}.protocols span{color:var(--muted);font-size:10px}.active-fast{display:grid;grid-template-columns:300px 1fr;gap:28px;padding:25px;background:linear-gradient(135deg,var(--card),color-mix(in srgb,var(--stage) 12%,var(--card)));border:1px solid var(--stage);border-radius:20px;align-items:center}.fast-ring{width:245px;height:245px;border-radius:50%;border:21px solid var(--stage);display:grid;place-content:center;text-align:center;box-shadow:0 0 35px color-mix(in srgb,var(--stage) 25%,transparent)}.fast-ring strong{font-size:36px}.fast-stage{display:inline-flex;gap:7px;color:var(--stage);font-weight:800}.active-fast button{margin-right:8px;padding:10px 13px;border-radius:9px;border:1px solid var(--line);background:var(--card2);color:var(--text)}.active-fast .end-fast{background:var(--stage);color:#07110a}.fasting-grid{display:grid;grid-template-columns:1.1fr 1.2fr .8fr;gap:12px}.fasting-grid article{background:var(--card);border:1px solid var(--line);border-radius:15px;padding:15px;min-width:0}.fasting-grid article>button{width:100%;display:grid;grid-template-columns:1fr auto auto;border:0;border-bottom:1px solid var(--line);background:transparent;color:var(--text);padding:10px}.fasting-grid i{color:var(--muted)}.fast-heat-wrap{overflow:auto}.fast-heat{display:grid;grid-template-rows:repeat(7,10px);grid-auto-flow:column;grid-auto-columns:10px;gap:4px;min-width:max-content}.fast-heat i{border-radius:2px;background:#252b27}.fast-heat i.partial{background:#7a683d}.fast-heat i.complete{background:#2d7d52}.fast-heat i.exceeded{background:#43b876}.fast-legend{display:flex;gap:10px;flex-wrap:wrap;margin-top:10px;font-size:9px;color:var(--muted)}.fast-legend span{display:flex;gap:4px;align-items:center}.fast-legend i{width:10px;height:10px;border-radius:2px}.fast-stat{font-size:28px;color:var(--primary)}.fast-stage-narrative{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.fast-stage-narrative article{border:1px solid var(--line);background:var(--card);border-radius:12px;padding:12px}.fast-stage-narrative h4{margin:6px 0}.fast-stage-narrative p{color:var(--muted);font-size:10px;line-height:1.45}.fast-layer{position:fixed;inset:0;z-index:110;display:grid}.fast-backdrop{position:absolute;inset:0;border:0;background:#000b}.fast-drawer{position:relative;justify-self:end;width:min(480px,100%);height:100%;background:#08120d;border-left:1px solid var(--line);padding:25px}.fast-drawer .close{float:right;background:var(--card2);color:var(--text);border:1px solid var(--line);border-radius:9px}.fast-drawer label{display:grid;gap:6px;color:var(--muted);margin:13px 0}.fast-drawer input{background:var(--card);border:1px solid var(--line);border-radius:10px;color:var(--text);padding:11px}@media(max-width:900px){.protocols{display:flex;overflow-x:auto}.protocols button{min-width:130px}.fasting-grid{grid-template-columns:1fr}.fast-stage-narrative{display:flex;overflow-x:auto}.fast-stage-narrative article{min-width:220px}}@media(max-width:650px){.active-fast{grid-template-columns:1fr}.fast-ring{margin:auto}.fast-drawer{align-self:end;width:100%;height:90vh;border-radius:18px 18px 0 0}}
