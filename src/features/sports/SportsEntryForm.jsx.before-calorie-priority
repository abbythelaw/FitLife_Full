  maxHr: 'Maximum heart rate',
  elevation: 'Elevation gain, m',
  steps: 'Steps',
  packWeight: 'Pack weight, kg',
  cadence: 'Cadence',
  power: 'Average power, W',
  resistance: 'Resistance level',
  poolLength: 'Pool length, m',
  stroke: 'Stroke',
