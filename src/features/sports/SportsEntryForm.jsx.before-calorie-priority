function readWeight() {
  try {
    const defs = JSON.parse(
      localStorage.getItem('fitlife-health-defs-v2') || '[]'
    )
    const weight = defs.find(metric =>
      String(metric.id).toLowerCase() === 'weight' ||
      String(metric.name).toLowerCase() === 'weight'
    )
    return number(weight?.current || weight?.value)
  } catch {
    return 0
  }
}

function estimateCalories({category, duration, distance, weight, rpe}) {
  if (!duration || !weight) return 0

  const hours = duration / 60
  const sport = category.toLowerCase()
  let met = 4

  if (sport.includes('running')) {
    if (distance && hours) {
      const speed = distance / hours
      met = speed >= 12 ? 12.5 : speed >= 10 ? 10 : speed >= 8 ? 8.3 : 6
    } else {
      met = 8
    }
  } else if (sport.includes('walking')) {
    const speed = distance && hours ? distance / hours : 4.5
    met = speed >= 6.5 ? 6.5 : speed >= 5.5 ? 4.8 : 3.5
  } else if (sport.includes('hiking')) {
    met = 6
  } else if (sport.includes('cycling')) {
    met = sport.includes('indoor') ? 7 : 8
  } else if (sport.includes('swimming')) {
    met = 7
  } else if (sport.includes('hyrox') || sport.includes('spartan')) {
    met = 10
  } else if (
    sport.includes('hiit') ||
    sport.includes('boxing') ||
    sport.includes('football')
  ) {
    met = 8
  } else if (sport.includes('tennis') || sport.includes('badminton')) {
    met = 6
  } else if (sport.includes('strength')) {
    met = 5
  } else if (sport.includes('yoga') || sport.includes('mobility')) {
    met = 2.8
  }

  if (rpe) met *= Math.max(0.75, Math.min(1.25, rpe / 6))

  return Math.max(1, Math.round(met * weight * hours))
}

export default function SportsEntryForm({
  entry,
  onCancel,
  onSave,
  defaultDate,
  onDirtyChange
}) {
  const initial = entry || {}
  const [saving, setSaving] = useState(false)
  const [dirty, setDirty] = useState(false)
  const [more, setMore] = useState(false)
  const saveLock = useRef(false)

  const [category, setCategory] = useState(initial.category || 'Walking')
  const [title, setTitle] = useState(initial.title || '')
  const [date, setDate] = useState(
    initial.entry_date || defaultDate || today()
  )
  const [start, setStart] = useState(initial.start_time || '07:30')
  const [duration, setDuration] = useState(
    initial.duration_minutes || 45
  )
  const [distance, setDistance] = useState(initial.distance_km || '')
  const [avgHr, setAvgHr] = useState(initial.average_hr || '')
  const [maxHr, setMaxHr] = useState(initial.max_hr || '')
  const [rpe, setRpe] = useState(initial.rpe || '')
  const [notes, setNotes] = useState(initial.notes || '')
  const [details, setDetails] = useState(initial.sport_details || {})
  const [manualCalories, setManualCalories] = useState(
    Boolean(initial.calories_overridden)
  )
  const [calorieValue, setCalorieValue] = useState(
    initial.calories_overridden ? initial.calories : ''
  )
  const [media, setMedia] = useState({
    photos: initial.photos || [],
    files: [],
    featured: initial.featured_index || 0,
    positionX: initial.position_x || 50,
    positionY: initial.position_y || 50
  })

  const template = useMemo(() => templateFor(category), [category])
  const weight = useMemo(readWeight, [])

  const estimatedCalories = useMemo(() => estimateCalories({
    category,
    duration: number(duration),
    distance: number(distance),
    weight,
    rpe: number(rpe)
  }), [category, duration, distance, weight, rpe])

  const calories = manualCalories
    ? number(calorieValue)
    : estimatedCalories

  const pace = number(distance) && number(duration)
    ? number(duration) / number(distance)
    : 0

  const speed = number(distance) && number(duration)
    ? number(distance) / (number(duration) / 60)
    : 0

  const end = useMemo(() => {
    const [hours, minutes] = start.split(':').map(Number)
    const total = hours * 60 + minutes + number(duration)
    return `${String(Math.floor(total / 60) % 24).padStart(2, '0')}:${String(total % 60).padStart(2, '0')}`
  }, [start, duration])

  useEffect(() => {
    onDirtyChange?.(dirty)
  }, [dirty, onDirtyChange])

  useEffect(() => {
    const guard = event => {
      if (!dirty || saving) return
      event.preventDefault()
      event.returnValue = ''
    }
    window.addEventListener('beforeunload', guard)
    return () => window.removeEventListener('beforeunload', guard)
  }, [dirty, saving])

  function changed(setter, value) {
    setter(value)
    setDirty(true)
  }

  function setDetail(field, value) {
    setDetails(previous => ({...previous, value}))
    setDirty(true)
  }

  function renderDetailField(field) {
    const label = FIELD_LABELS[field] || field
    const textFields = [
      'sessionType', 'format', 'score', 'opponent', 'routine',
      'division', 'raceType', 'course', 'position', 'style',
      'bodyAreas', 'terrain', 'highestGrade', 'stroke'
    ]
    return (
      <label key={field}>
        {label}
        <input
          type={textFields.includes(field) ? 'text' : 'number'}
          step="any"
          value={details[field] ?? ''}
          onChange={event => setDetail(field, event.target.value)}
        />
      </label>
    )
  }

  async function submit(event) {
    event.preventDefault()
    if (saving || saveLock.current) return

    saveLock.current = true
    setSaving(true)

    try {
      await onSave({
        ...initial,
        category,
        title: title.trim() || `${category} activity`,
        entry_date: date,
        start_time: start,
        end_time: end,
        duration_minutes: number(duration),
        distance_km: number(distance),
        pace_min_km: pace,
        average_speed_kmh: speed,
        calories,
        estimated_calories: estimatedCalories,
        calories_overridden: manualCalories,
        calorie_method: manualCalories ? 'manual' : 'estimated_met',
        calorie_weight_kg: weight || null,
        average_hr: number(avgHr) || null,
        max_hr: number(maxHr) || null,
        rpe: number(rpe) || null,
        training_load: number(duration) * number(rpe),
        sport_details: details,
        notes
      }, media)
      setDirty(false)
    } finally {
      setSaving(false)
      saveLock.current = false
    }
  }

  return (
    <form className="sports-form" onSubmit={submit}>
      <div className="sports-form-grid">
        <label>
          Sport
          <select
            value={category}
            onChange={event => changed(setCategory, event.target.value)}
          >
            {SPORT_GROUPS.map(group => (
              <optgroup key={group.label} label={group.label}>
                {group.sports.map(sport => (
                  <option key={sport}>{sport}</option>
                ))}
              </optgroup>
            ))}
          </select>
        </label>

        <label>
          Activity title
          <input
            value={title}
            onChange={event => changed(setTitle, event.target.value)}
            placeholder={`${category} activity`}
          />
        </label>

        <label>
          Date
          <input
            type="date"
            max={today()}
            value={date}
            onChange={event => changed(setDate, event.target.value)}
            required
          />
        </label>

        <label>
          Start time
          <input
            type="time"
            value={start}
            onChange={event => changed(setStart, event.target.value)}
            required
          />
        </label>

        <label>
          Duration, minutes
          <input
            type="number"
            min="1"
            value={duration}
            onChange={event => changed(setDuration, event.target.value)}
            required
          />
        </label>

        <label>
          End time
          <input value={end} disabled />
        </label>

        {sportHasField(template, 'distance') && (
          <label>
            Distance, km
            <input
              type="number"
              min="0"
              step="0.01"
              value={distance}
              onChange={event => changed(setDistance, event.target.value)}
              required={template.fields.includes('distance')}
            />
          </label>
        )}

        {sportHasField(template, 'averageHr') && (
          <label>
            Average heart rate
            <input
              type="number"
              min="30"
              max="250"
              value={avgHr}
              onChange={event => changed(setAvgHr, event.target.value)}
            />
          </label>
        )}

        {sportHasField(template, 'rpe') && (
          <label>
            RPE, 1–10
            <input
              type="number"
              min="1"
              max="10"
              value={rpe}
              onChange={event => changed(setRpe, event.target.value)}
              required
            />
          </label>
        )}

        {pace > 0 && (
          <label>
            Calculated pace
            <input value={`${pace.toFixed(2)} min/km`} disabled />
          </label>
        )}

        {speed > 0 && (
          <label>
            Calculated speed
            <input value={`${speed.toFixed(2)} km/h`} disabled />
          </label>
        )}

        <label>
          Calories
          <input
            type="number"
            min="0"
            value={manualCalories ? calorieValue : calories || ''}
            disabled={!manualCalories}
            placeholder={
              weight ? 'Automatically estimated' : 'Add weight in Health Metrics'
            }
            onChange={event => changed(setCalorieValue, event.target.value)}
          />
          <span className="sports-calorie-toggle">
            <input
              type="checkbox"
              checked={manualCalories}
              onChange={event => changed(
                setManualCalories,
                event.target.checked
              )}
            />
            Override calculated calories
          </span>
        </label>
      </div>

      <button
        type="button"
        className="sports-more-toggle"
        onClick={() => setMore(value => !value)}
      >
        <ChevronDown className={more ? 'open' : ''} />
        {more ? 'Hide details' : 'More details'}
      </button>

      {more && (
        <div className="sports-form-grid sports-more-fields">
          {template.optional
            .filter(field => !['distance', 'averageHr', 'maxHr'].includes(field))
            .map(renderDetailField)}

          {template.optional.includes('maxHr') && (
            <label>
              Maximum heart rate
              <input
                type="number"
                min="30"
                max="250"
                value={maxHr}
                onChange={event => changed(setMaxHr, event.target.value)}
              />
            </label>
          )}

          <label className="sports-notes-field">
            Notes
            <textarea
              value={notes}
              onChange={event => changed(setNotes, event.target.value)}
            />
          </label>
        </div>
      )}

      <MediaEditor
        existing={initial.photos || []}
        positionX={initial.position_x || 50}
        positionY={initial.position_y || 50}
        onChange={value => {
          setMedia(value)
          setDirty(true)
        }}
      />

      <div className="sports-form-actions">
        <button type="button" onClick={onCancel}>
          Cancel
        </button>
        <button className="primary" disabled={saving}>
          <Save />
          {saving ? 'Saving…' : 'Save activity'}
        </button>
      </div>
    </form>
  )
}
