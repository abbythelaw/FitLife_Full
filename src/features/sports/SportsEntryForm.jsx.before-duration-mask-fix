const today = () => {
  const date = new Date()
  const offset = date.getTimezoneOffset() * 60000
  return new Date(date.getTime() - offset).toISOString().slice(0, 10)
}

const number = value => {
  const parsed = Number(value)
  return Number.isFinite(parsed) ? parsed : 0
}

const durationDigits = value => String(value ?? '').replace(/\D/g, '').slice(-6).padStart(6, '0')
const formatDurationDigits = value => {
  const digits = durationDigits(value)
  return `${digits.slice(0, 2)}:${digits.slice(2, 4)}:${digits.slice(4, 6)}`
}
const secondsToDuration = value => {
  const total = Math.max(0, Math.round(Number(value) || 0))
  const hours = Math.floor(total / 3600)
  const minutes = Math.floor((total % 3600) / 60)
  const seconds = total % 60
  return [hours, minutes, seconds].map(part => String(part).padStart(2, '0')).join(':')
}
const durationToSeconds = value => {
  const [hours, minutes, seconds] = formatDurationDigits(value).split(':').map(Number)
  return hours * 3600 + minutes * 60 + seconds
}

