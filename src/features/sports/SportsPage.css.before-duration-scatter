/* FORCE SCROLLABLE SPORTS POPOUTS */

.sports-layer {
  position: fixed !important;
  z-index: 9999 !important;
  inset: 0 !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  width: 100vw !important;
  height: 100vh !important;
  height: 100dvh !important;

  padding:
    max(12px, env(safe-area-inset-top))
    max(12px, env(safe-area-inset-right))
    max(12px, env(safe-area-inset-bottom))
    max(12px, env(safe-area-inset-left)) !important;

  overflow: hidden !important;
  box-sizing: border-box !important;
}

.sports-layer .sports-backdrop {
  position: absolute !important;
  z-index: 0 !important;
  inset: 0 !important;

  width: 100% !important;
  height: 100% !important;

  border: 0 !important;
  background: rgba(0, 0, 0, .68) !important;
}

/* Add/edit activity popout */
.sports-layer > .sports-drawer {
  position: relative !important;
  z-index: 2 !important;

  inset: auto !important;
  transform: none !important;

  display: flex !important;
  flex-direction: column !important;

  width: min(920px, 100%) !important;
  height: auto !important;
  min-height: 0 !important;

  max-width: 100% !important;
  max-height: calc(100dvh - 24px) !important;

  margin: auto !important;

  overflow-x: hidden !important;
  overflow-y: auto !important;

  overscroll-behavior: contain !important;
  -webkit-overflow-scrolling: touch !important;
  touch-action: pan-y pinch-zoom !important;

  border-radius: 24px !important;
  box-sizing: border-box !important;
}

/* Activity analysis popout */
.sports-layer > .sports-detail,
.sports-layer > .sports-analysis-detail {
  position: relative !important;
  z-index: 2 !important;

  inset: auto !important;
  top: auto !important;
  right: auto !important;
  bottom: auto !important;
  left: auto !important;

  display: block !important;

  width: min(960px, 100%) !important;
  height: auto !important;
  min-height: 0 !important;

  max-width: 100% !important;
  max-height: calc(100dvh - 24px) !important;

  margin: auto !important;

  overflow-x: hidden !important;
  overflow-y: auto !important;

  overscroll-behavior: contain !important;
  -webkit-overflow-scrolling: touch !important;
  touch-action: pan-y pinch-zoom !important;

  border-radius: 24px !important;
  transform: none !important;
  box-sizing: border-box !important;
}

/* Delete confirmation */
.sports-layer > .sports-delete {
  position: relative !important;
  z-index: 2 !important;

  inset: auto !important;
  transform: none !important;

  width: min(520px, 100%) !important;
  max-height: calc(100dvh - 24px) !important;

  margin: auto !important;
  overflow-y: auto !important;

  touch-action: pan-y pinch-zoom !important;
}

/* Sticky add/edit heading */
.sports-drawer-head {
  position: sticky !important;
  z-index: 50 !important;
  top: 0 !important;

  flex: 0 0 auto !important;

  padding-top: max(16px, env(safe-area-inset-top)) !important;

  background: rgba(16, 37, 28, .96) !important;

  backdrop-filter: blur(18px) !important;
  -webkit-backdrop-filter: blur(18px) !important;
}

/* The form must not trap or disable scrolling */
.sports-drawer .sports-form {
  display: block !important;

  width: 100% !important;
  min-width: 0 !important;
  min-height: auto !important;

  overflow: visible !important;

  padding-bottom: 12px !important;
  box-sizing: border-box !important;
}

/* Sticky Cancel and Save */
.sports-drawer .sports-form-actions {
  position: sticky !important;
  z-index: 60 !important;
  bottom: 0 !important;

  display: grid !important;
  grid-template-columns: 1fr 1fr !important;
  gap: 10px !important;

  width: 100% !important;

  margin-top: 20px !important;
  padding:
    14px
    0
    max(14px, env(safe-area-inset-bottom)) !important;

  border-top: 1px solid rgba(148, 163, 184, .18) !important;

  background:
    linear-gradient(
      to top,
      rgba(16, 37, 28, 1) 75%,
      rgba(16, 37, 28, .94)
    ) !important;
}

.sports-drawer .sports-form-actions button {
  width: 100% !important;
  min-width: 0 !important;
  min-height: 46px !important;
}

/* Analysis controls stay visible */
.sports-analysis-detail .sports-analysis-top-actions {
  position: sticky !important;
  z-index: 70 !important;
  top: 8px !important;

  display: flex !important;
  justify-content: flex-end !important;
  gap: 8px !important;

  width: fit-content !important;
  height: auto !important;

  margin:
    8px
    8px
    -52px
    auto !important;

  padding: 0 !important;
  pointer-events: none !important;
}

.sports-analysis-detail .sports-analysis-top-actions button {
  min-width: 44px !important;
  min-height: 44px !important;
  pointer-events: auto !important;
}

/* Prevent inner elements from blocking the parent scroll */
.sports-analysis-content,
.sports-analysis-content > section,
.media-editor-direct,
.sports-form-grid {
  min-height: 0 !important;
  overflow: visible !important;
}

/* Dot plots can move horizontally without blocking vertical scrolling */
.sports-dotplot {
  max-width: 100% !important;
  overflow-x: auto !important;
  overflow-y: hidden !important;

  overscroll-behavior-x: contain !important;
  touch-action: pan-x pan-y pinch-zoom !important;
}

/* Phone and narrow browser windows */
@media (max-width: 680px) {
  .sports-layer {
    display: block !important;
    padding: 0 !important;
  }

  .sports-layer > .sports-drawer,
  .sports-layer > .sports-detail,
  .sports-layer > .sports-analysis-detail {
    width: 100% !important;

    height: 100vh !important;
    height: 100dvh !important;

    min-height: 100vh !important;
    min-height: 100dvh !important;

    max-height: 100vh !important;
    max-height: 100dvh !important;

    margin: 0 !important;

    overflow-x: hidden !important;
    overflow-y: auto !important;

    border-radius: 0 !important;

    padding-bottom: env(safe-area-inset-bottom) !important;
  }

  .sports-layer > .sports-delete {
    position: absolute !important;
    top: 50% !important;
    left: 12px !important;

    width: calc(100% - 24px) !important;
