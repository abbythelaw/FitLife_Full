/* Sports V1 dynamic form */
.sports-calorie-toggle {
  display: flex;
  align-items: center;
  gap: .55rem;
  margin-top: .55rem;
  font-size: .78rem;
  font-weight: 700;
  color: var(--muted, #64748b);
}

.sports-calorie-toggle input {
  width: auto;
  margin: 0;
}

.sports-more-toggle {
  display: flex;
  align-items: center;
  gap: .5rem;
  margin: 1rem 0;
  border: 0;
  background: transparent;
  color: #6d5dfc;
  font-weight: 800;
  cursor: pointer;
}

.sports-more-toggle svg {
  width: 18px;
  transition: transform .2s ease;
}

.sports-more-toggle svg.open {
  transform: rotate(180deg);
}

.sports-more-fields {
  padding: 1rem;
  border: 1px solid rgba(109, 93, 252, .14);
  border-radius: 18px;
  background: rgba(109, 93, 252, .035);
}

.sports-notes-field {
  grid-column: 1 / -1;
}

.sports-feed {
  display: grid !important;
  grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
  align-items: stretch;
  gap: 1.1rem;
}

.sports-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  height: 100%;
  overflow: hidden;
}

.sports-card > .media-carousel,
.sports-card > [class*="media"] {
  width: 100%;
  aspect-ratio: 16 / 9;
  min-height: 190px;
  max-height: 190px;
  overflow: hidden;
}

.sports-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.sports-card-body {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.sports-card-actions {
  margin-top: auto;
}

@media (max-width: 700px) {
  .sports-feed {
    grid-template-columns: 1fr;
  }

  .sports-card > .media-carousel,
  .sports-card > [class*="media"] {
    min-height: 180px;
    max-height: 180px;
  }
}


/* Sports compact uniform cards */

.sports-feed {
  display: grid !important;
  grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  align-items: stretch !important;
  gap: 18px !important;
}

.sports-card.sports-card-compact {
  display: flex !important;
  flex-direction: column !important;
  width: 100% !important;
  min-width: 0 !important;
  height: 100% !important;
  min-height: 0 !important;
  overflow: hidden !important;
  border-radius: 22px !important;
  cursor: pointer;
}

.sports-card-compact:first-child {
  grid-column: auto !important;
  grid-row: auto !important;
  width: 100% !important;
  max-width: none !important;
}

.sports-card-compact .sports-card-cover {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 8.5;
  min-height: 0;
  max-height: none;
  overflow: hidden;
  flex: 0 0 auto;
}

.sports-card-compact .sports-card-cover > * {
  width: 100%;
  height: 100%;
}

.sports-card-compact .sports-card-cover img,
.sports-card-compact .sports-card-cover video {
  display: block;
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
}

.sports-card-compact .sports-card-body {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  padding: 18px;
}

.sports-card-heading {
  min-width: 0;
  margin-bottom: 14px;
}

.sports-card-heading .sports-category {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 7px;
  font-size: 13px;
  font-weight: 800;
}

.sports-card-heading .sports-category svg {
  width: 16px;
  height: 16px;
}

.sports-card-heading > small {
  display: block;
  margin-bottom: 5px;
  opacity: .7;
}

.sports-card-heading h3 {
  margin: 0;
  overflow: hidden;
  font-size: clamp(18px, 2vw, 24px);
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sports-card-stat-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 9px;
}

.sports-card-stat {
  display: grid;
  grid-template-columns: auto 1fr;
  align-items: baseline;
  min-width: 0;
  padding: 11px 12px;
  border: 1px solid rgba(120, 150, 130, .22);
  border-radius: 14px;
  background: rgba(15, 40, 29, .48);
}

.sports-card-stat strong {
  min-width: 0;
  overflow: hidden;
  font-size: 17px;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sports-card-stat > span {
  margin-left: 4px;
  overflow: hidden;
  font-size: 11px;
  font-weight: 700;
  opacity: .76;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sports-card-stat small {
  grid-column: 1 / -1;
  margin-top: 7px;
  overflow: hidden;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .04em;
  opacity: .65;
  text-overflow: ellipsis;
  text-transform: uppercase;
  white-space: nowrap;
}

.sports-card-compact .sports-card-actions {
  display: flex;
  justify-content: flex-end;
  gap: 9px;
  margin-top: auto;
  padding-top: 16px;
}

.sports-card-compact .sports-card-actions button {
  min-height: 40px;
  padding: 9px 12px;
  border-radius: 12px;
}

.sports-card-compact .sports-card-actions svg {
  width: 17px;
  height: 17px;
}

@media (max-width: 900px) {
  .sports-card-stat-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 680px) {
  .sports-feed {
    grid-template-columns: 1fr !important;
    gap: 14px !important;
  }

  .sports-card-compact .sports-card-cover {
    aspect-ratio: 16 / 8;
  }

  .sports-card-compact .sports-card-body {
    padding: 15px;
  }

  .sports-card-stat-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .sports-card-compact .sports-card-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .sports-card-compact .sports-card-actions button {
    justify-content: center;
    width: 100%;
  }
}


/* Sport-specific emoji and personal bests */

.sports-category-emoji {
  display: inline-grid;
  place-items: center;
  width: 24px;
  height: 24px;
  margin-right: 2px;
  font-size: 18px;
  line-height: 1;
  filter: saturate(1.08);
}

.sports-card-stat {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  transition:
    border-color .2s ease,
    box-shadow .2s ease,
    transform .2s ease;
}

.sports-card-stat.is-record {
  transform: translateY(-1px);
}

.sports-card-stat.is-ever {
  border-color: rgba(255, 215, 83, .85) !important;
  background:
    linear-gradient(
      135deg,
      rgba(103, 70, 8, .58),
      rgba(31, 43, 25, .88) 48%,
      rgba(116, 79, 9, .55)
    ) !important;
  box-shadow:
    0 0 0 1px rgba(255, 225, 119, .12),
    0 0 20px rgba(255, 193, 41, .17),
    inset 0 1px 0 rgba(255, 244, 195, .22);
}

.sports-card-stat.is-ever::before {
  position: absolute;
  z-index: -1;
  top: -45%;
  left: -65%;
  width: 42%;
  height: 190%;
  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(255, 250, 214, .25),
      transparent
    );
  content: "";
  transform: rotate(18deg);
  animation: sports-record-shimmer 4.5s ease-in-out infinite;
  pointer-events: none;
}

.sports-card-stat.is-ever strong,
.sports-card-stat.is-ever > span {
  color: #ffe78b;
  text-shadow: 0 0 12px rgba(255, 205, 64, .3);
}

.sports-card-stat.is-ever small {
  color: #f6d96a;
  opacity: .9;
}

.sports-card-stat.is-year {
  border-color: rgba(168, 139, 250, .75) !important;
  background:
    linear-gradient(
      135deg,
      rgba(73, 54, 133, .55),
      rgba(19, 47, 35, .88)
    ) !important;
  box-shadow:
    0 0 17px rgba(139, 92, 246, .14),
    inset 0 1px 0 rgba(221, 214, 254, .15);
}

.sports-card-stat.is-year strong,
.sports-card-stat.is-year > span {
  color: #ddd6fe;
}

.sports-card-stat.is-year small {
  color: #c4b5fd;
  opacity: .9;
}

.sports-record-corner {
  position: absolute;
  top: 6px;
  right: 7px;
  margin: 0 !important;
  font-size: 13px !important;
  line-height: 1;
}

.sports-achievement-row {
  display: flex;
  align-items: center;
  gap: 7px;
  min-height: 35px;
  margin-top: 13px;
  overflow: hidden;
}

.sports-achievement {
  display: inline-flex;
  align-items: center;
  min-width: 0;
  max-width: calc(50% - 4px);
  gap: 6px;
  padding: 7px 9px;
  border: 1px solid;
  border-radius: 999px;
  font-size: 10px;
  line-height: 1;
  white-space: nowrap;
}

.sports-achievement b {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sports-achievement.is-ever {
  border-color: rgba(255, 215, 83, .55);
  background:
    linear-gradient(
      110deg,
      rgba(138, 91, 7, .55),
      rgba(65, 54, 20, .55)
    );
  color: #ffe78b;
  box-shadow: 0 0 14px rgba(255, 193, 41, .11);
}

.sports-achievement.is-year {
  border-color: rgba(167, 139, 250, .48);
  background: rgba(91, 65, 157, .32);
  color: #ddd6fe;
}

.sports-achievement-more {
  display: inline-grid;
  flex: 0 0 auto;
  place-items: center;
  min-width: 28px;
  height: 28px;
  padding: 0 6px;
  border: 1px solid rgba(148, 163, 184, .22);
  border-radius: 999px;
  background: rgba(15, 23, 42, .31);
  color: #cbd5e1;
  font-size: 10px;
  font-weight: 800;
}

.sports-achievement-placeholder {
  display: block;
  height: 29px;
}

@keyframes sports-record-shimmer {
  0%,
  62% {
    left: -65%;
    opacity: 0;
  }

  68% {
    opacity: 1;
  }

  84% {
    left: 140%;
    opacity: 1;
  }

  100% {
    left: 140%;
    opacity: 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .sports-card-stat.is-ever::before {
    display: none;
    animation: none;
  }
}

@media (max-width: 680px) {
  .sports-achievement-row {
    gap: 6px;
  }

  .sports-achievement {
    max-width: calc(50% - 3px);
    padding: 7px 8px;
  }
}


/* Sports activity analysis */

.sports-analysis-detail {
  position: fixed;
  z-index: 1002;
  inset: 4vh auto auto 50%;
  width: min(960px, calc(100vw - 32px));
  max-height: 92vh;
  overflow: auto;
  border-radius: 26px;
  transform: translateX(-50%);
  background: var(--panel, #10251c);
  box-shadow: 0 30px 100px rgba(0, 0, 0, .46);
}

.sports-analysis-detail > .media-carousel,
.sports-analysis-detail > [class*="media"] {
  width: 100%;
  min-height: 290px;
  max-height: 390px;
  aspect-ratio: 16 / 7;
  overflow: hidden;
}

.sports-analysis-detail img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.sports-analysis-top-actions {
  position: sticky;
  z-index: 8;
  top: 12px;
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  height: 0;
  padding: 0 14px;
}

.sports-analysis-top-actions button {
  min-height: 40px;
  padding: 8px 13px;
  border-radius: 12px;
  backdrop-filter: blur(16px);
  background: rgba(7, 20, 14, .82);
}

.sports-analysis-top-actions .close {
  display: grid;
  place-items: center;
  width: 42px;
  padding: 0;
}

.sports-analysis-content {
  display: grid;
  gap: 24px;
  padding: 24px;
}

.sports-analysis-content > section {
  min-width: 0;
  padding: 20px;
  border: 1px solid rgba(148, 163, 184, .14);
  border-radius: 20px;
  background: rgba(255, 255, 255, .025);
}

.sports-analysis-heading h2 {
  margin: 8px 0 5px;
  font-size: clamp(25px, 4vw, 38px);
}

.sports-analysis-heading p {
  display: flex;
  align-items: center;
  gap: 7px;
  margin: 0;
  opacity: .72;
}

.sports-analysis-heading p svg {
  width: 16px;
}

.sports-analysis-section-title {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 15px;
}

.sports-analysis-section-title small,
.sports-fitlife-insight small,
.sports-analysis-notes small {
  color: #78e68e;
  font-weight: 900;
  letter-spacing: .09em;
}

.sports-analysis-section-title h3 {
  margin: 4px 0 0;
}

.sports-analysis-section-title > span {
  font-size: 12px;
  opacity: .65;
}

.sports-analysis-metrics,
.sports-comparison-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.sports-analysis-metric {
  display: grid;
  grid-template-columns: auto auto 1fr;
  align-items: baseline;
  min-width: 0;
  padding: 14px;
  border: 1px solid rgba(112, 226, 54, .15);
  border-radius: 16px;
  background: rgba(8, 31, 20, .45);
}

.sports-analysis-metric svg {
  grid-row: 1 / 3;
  width: 18px;
  margin-right: 10px;
  color: #70e236;
}

.sports-analysis-metric strong {
  font-size: 21px;
}

.sports-analysis-metric > span {
  margin-left: 4px;
  font-size: 11px;
  opacity: .68;
}

.sports-analysis-metric small {
  grid-column: 2 / -1;
  margin-top: 5px;
  font-weight: 800;
  opacity: .62;
}

.sports-analysis-achievements {
  display: grid;
  gap: 9px;
}

.sports-analysis-achievement {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 14px 16px;
  border: 1px solid;
  border-radius: 16px;
}

.sports-analysis-achievement > span {
  font-size: 25px;
}

.sports-analysis-achievement div {
  display: grid;
  gap: 4px;
}

.sports-analysis-achievement small {
  opacity: .67;
}

.sports-analysis-achievement.is-ever {
  border-color: rgba(255, 215, 83, .55);
  background:
    linear-gradient(
      120deg,
      rgba(125, 81, 6, .52),
      rgba(59, 50, 19, .3)
    );
  color: #ffe78b;
}

.sports-analysis-achievement.is-year {
  border-color: rgba(251, 191, 36, .4);
  background: rgba(120, 76, 7, .25);
  color: #fde68a;
}

.sports-analysis-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-bottom: 15px;
}

.sports-analysis-tabs button {
  min-height: 38px;
  padding: 8px 13px;
  border-radius: 999px;
}

.sports-analysis-tabs button.active {
  border-color: rgba(112, 226, 54, .72);
  background: rgba(112, 226, 54, .16);
  color: #b9ff9f;
}

.sports-comparison-box {
  display: grid;
  grid-template-columns: auto 1fr;
  min-width: 0;
  padding: 14px;
  border: 1px solid rgba(148, 163, 184, .16);
  border-radius: 16px;
  background: rgba(7, 24, 16, .42);
}

.sports-comparison-box svg {
  grid-row: 1 / 4;
  width: 18px;
  margin-right: 10px;
}

.sports-comparison-box strong,
.sports-comparison-box small,
.sports-comparison-box span {
  min-width: 0;
}

.sports-comparison-box small {
  margin-top: 4px;
  opacity: .67;
}

.sports-comparison-box > span {
  margin-top: 6px;
  font-size: 11px;
  opacity: .55;
}

.sports-comparison-box.positive {
  border-color: rgba(74, 222, 128, .35);
}

.sports-comparison-box.positive svg {
  color: #4ade80;
}

.sports-comparison-box.negative {
  border-color: rgba(251, 113, 133, .3);
}

.sports-comparison-box.negative svg {
  color: #fb7185;
}

.sports-analysis-empty {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 7px;
  padding: 18px;
  border: 1px dashed rgba(148, 163, 184, .24);
