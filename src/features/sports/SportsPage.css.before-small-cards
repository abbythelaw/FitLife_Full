/* Sports V1 dynamic form */
.sports-calorie-toggle {
  display: flex;
  align-items: center;
  gap: .55rem;
  margin-top: .55rem;
  font-size: .78rem;
  font-weight: 700;
  color: var(--muted, #64748b);
}

.sports-calorie-toggle input {
  width: auto;
  margin: 0;
}

.sports-more-toggle {
  display: flex;
  align-items: center;
  gap: .5rem;
  margin: 1rem 0;
  border: 0;
  background: transparent;
  color: #6d5dfc;
  font-weight: 800;
  cursor: pointer;
}

.sports-more-toggle svg {
  width: 18px;
  transition: transform .2s ease;
}

.sports-more-toggle svg.open {
  transform: rotate(180deg);
}

.sports-more-fields {
  padding: 1rem;
  border: 1px solid rgba(109, 93, 252, .14);
  border-radius: 18px;
  background: rgba(109, 93, 252, .035);
}

.sports-notes-field {
  grid-column: 1 / -1;
}

.sports-feed {
  display: grid !important;
  grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
  align-items: stretch;
  gap: 1.1rem;
}

.sports-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  height: 100%;
  overflow: hidden;
}

.sports-card > .media-carousel,
.sports-card > [class*="media"] {
  width: 100%;
  aspect-ratio: 16 / 9;
  min-height: 190px;
  max-height: 190px;
  overflow: hidden;
}

.sports-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.sports-card-body {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.sports-card-actions {
  margin-top: auto;
}

@media (max-width: 700px) {
  .sports-feed {
    grid-template-columns: 1fr;
  }

  .sports-card > .media-carousel,
  .sports-card > [class*="media"] {
    min-height: 180px;
    max-height: 180px;
  }
}
