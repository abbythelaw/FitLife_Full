function latestHealthReading(metricId) {
  const primary = read('fitlife-health-readings-v2', [])
  const fallback = read('fitlife-health-readings', [])
  const rows = primary.length ? primary : fallback
  const today = dateKey()

  return rows
    .filter(row => String(row.metric_id) === String(metricId))
    .filter(row => {
      const savedDate =
        row.record_date ||
        row.local_date ||
        String(row.recorded_at || row.date || '').slice(0, 10)

      return savedDate && savedDate <= today
    })
    .sort((a, b) =>
      String(b.recorded_at || b.record_date || '').localeCompare(
        String(a.recorded_at || a.record_date || '')
      )
    )[0] || null
}

function liveHealthMetrics() {
  return BASE_METRICS.map(metric => {
    const reading = latestHealthReading(metric.id)

    if (!reading) return metric

    const number = Number(reading.value)
    const definition = read('fitlife-health-defs-v2', [])
      .find(item => String(item.id) === String(metric.id))

    const unit = definition?.unit || ''
    const decimals = Number(definition?.decimals ?? 0)

    return {
      ...metric,
      value: Number.isFinite(number)
        ? `${number.toLocaleString('en-GB', {
            maximumFractionDigits: decimals
          })}${unit ? ` ${unit}` : ''}`
        : metric.value,
      status: definition?.targetMode === 'minimum'
        ? number >= Number(definition.target)
          ? 'Target reached'
          : 'Under target'
        : definition?.targetMode === 'range'
          ? number < Number(definition.min)
            ? 'Under range'
            : number > Number(definition.max)
              ? 'Over range'
              : 'In range'
          : metric.status
    }
  })
}

function Glance({ habits, logs, fasting, workouts }) {
  const [healthVersion, setHealthVersion] = useState(0)

  useEffect(() => {
    const refresh = () => {
      setHealthVersion(value => value + 1)
    }

    window.addEventListener(
      'fitlife:health-readings-changed',
      refresh
    )
    window.addEventListener(
      'fitlife:log-history-changed',
      refresh
    )
    window.addEventListener('storage', refresh)

    return () => {
      window.removeEventListener(
        'fitlife:health-readings-changed',
        refresh
      )
      window.removeEventListener(
        'fitlife:log-history-changed',
        refresh
      )
      window.removeEventListener('storage', refresh)
    }
  }, [])

  const healthMetrics = useMemo(
    () => liveHealthMetrics(),
    [healthVersion]
  )

  const [selected, setSelected] = useState(() => read('fitlife-glance-selected', ['sleep','steps','fasting','habits','workout','rhr']))
  const [max, setMax] = useState(() => Number(localStorage.getItem('fitlife-glance-max') || 6))
  const [open, setOpen] = useState(false)
  const list = [...healthMetrics,
    {id:'fasting',label:'Fasting',value:fasting?clock(Date.now()-new Date(fasting.started_at)):'Not active',status:'Fasting',color:'#f58b42',Icon:Flame,target:'fasting'},
    {id:'habits',label:'Habits',value:`${logs.filter(x=>x.completed&&x.log_date===dateKey()).length}/${Math.max(1,habits.length)}`,status:'Completed today',color:'#f1c34d',Icon:Target,target:'habits'},
    {id:'workout',label:'Workout',value:workouts[0]?`${workouts[0].duration_minutes} min`:'Not logged',status:'Exercises',color:'#38bdf8',Icon:Dumbbell,target:'exercises'}
  ]
  const shown=list.filter(x=>selected.includes(x.id)).slice(0,max)
  function toggle(id){const exists=selected.includes(id);if(!exists&&selected.length>=max)return;const next=exists?selected.filter(x=>x!==id):[...selected,id];setSelected(next);localStorage.setItem('fitlife-glance-selected',JSON.stringify(next))}
  function changeMaximum(value){setMax(value);localStorage.setItem('fitlife-glance-max',String(value));if(selected.length>value){const next=selected.slice(0,value);setSelected(next);localStorage.setItem('fitlife-glance-selected',JSON.stringify(next))}}
